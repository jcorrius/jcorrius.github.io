{
  "name": "jcorrius-personal-website",
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit"
  },
  "description": "Modernized personal resume website built with TypeScript, Vite, and Bootstrap 5.",
  "keywords": [
    "resume",
    "portfolio",
    "personal-website",
    "typescript",
    "vite",
    "bootstrap",
    "responsive",
    "modern"
  ],
  "homepage": "https://jcorrius.github.io",
  "bugs": {
    "url": "https://github.com/jcorrius/jcorrius.github.io/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Jesús Corrius",
    "email": "jcorrius@gmail.com",
    "url": "https://github.com/jcorrius"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jcorrius/jcorrius.github.io.git"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "bootstrap": "^5.3.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.1.0",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "@vitejs/plugin-legacy": "^8.1.0",
    "@vitest/ui": "^4.1.10",
    "autoprefixer": "^10.5.2",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.16",
    "prettier": "^3.9.4",
    "sass": "^1.101.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "core-js@3.49.0": true
  }
}
